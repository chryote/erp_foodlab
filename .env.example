# Root Docker Compose Environment Configuration
COMPOSE_PROJECT_NAME=erp_foodlab

# Application Ports
FRONTEND_PORT=5173
BACKEND_HTTP_PORT=8000
MYSQL_PORT=3306
REDIS_PORT=6379
MEILISEARCH_PORT=7700
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# MySQL 8.0 Credentials
MYSQL_DATABASE=erp_foodlab
MYSQL_USER=foodlab
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root_secret

# Redis Configuration
REDIS_PASSWORD=null

# Meilisearch Configuration
MEILISEARCH_KEY=foodlab_meili_master_key

# Grafana Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# k6 Target Base URL (inside Docker network)
K6_BASE_URL=http://nginx:80
