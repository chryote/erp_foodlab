APP_NAME="ERP FoodLab API"
APP_ENV=local
APP_KEY=base64:8rN0m6q4w2e9r1t3y5u7i9o0p2a4s6d8f0g2h4j6k8l=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=erp_foodlab
DB_USERNAME=foodlab
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis
CACHE_PREFIX=erp_foodlab_cache_

QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=foodlab_meili_master_key

PROMETHEUS_NAMESPACE=erp_foodlab
PROMETHEUS_ENABLED=true

# Document storage configuration (switch to s3 + private when moving to cloud buckets)
DOCUMENTS_DISK=public
DOCUMENTS_VISIBILITY=public
DOCUMENTS_MAX_SIZE_KB=10240
DOCUMENTS_TEMPORARY_URL_TTL=15

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.18.45:5173
